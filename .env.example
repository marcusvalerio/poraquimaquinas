# Copie para .env (local) ou cadastre em Vercel → Settings → Environment
# Variables. Nunca versione valores reais.

# =========================================================================
# 1. Banco de dados
# =========================================================================
# Neon: string *pooled* (host com "-pooler"), usada pela aplicação.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Neon: string direta (sem "-pooler"). Usada só pelos comandos de migration
# (`npm run db:migrate` / `db:status`). Não é necessária no build nem no
# runtime da Vercel.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# =========================================================================
# 2. Autenticação — obrigatórias em runtime
# =========================================================================
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
# Domínio público do app (produção). Também é o domínio gravado nos QR Codes.
NEXTAUTH_URL="https://seu-dominio.example.com"
# Só fora da Vercel, atrás de proxy reverso: "true". Na Vercel, deixe vazio.
AUTH_TRUST_HOST=""

# =========================================================================
# 3. Upload de fotos (Neon Object Storage, compatível com S3)
#    Obrigatórias para enviar/exibir fotos. O build não depende delas.
#    Neon Console → Connect → Storage. Somente no servidor.
# =========================================================================
AWS_ENDPOINT_URL_S3="https://br-xxxx.storage.REGION.aws.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
# Bucket privado no mesmo branch do Neon (padrão: equipment-photos).
STORAGE_BUCKET="equipment-photos"

# =========================================================================
# 4. Scripts locais (npm run seed / npm run admin:reset-password)
#    NÃO são usados pela aplicação nem pela Vercel.
# =========================================================================
ADMIN_EMAIL=""
ADMIN_NAME="Administrador"
ADMIN_PASSWORD=""
