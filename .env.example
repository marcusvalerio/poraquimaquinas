# --- Database (PostgreSQL) ---------------------------------------------
# Pooled connection string used by the running app (e.g. Neon's "-pooler" host).
DATABASE_URL="postgresql://user:password@host-pooler.example.com/dbname?sslmode=require"
# Direct (non-pooled) connection used only for running migrations.
DIRECT_URL="postgresql://user:password@host.example.com/dbname?sslmode=require"

# --- Auth (Auth.js / NextAuth v5) ---------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
# Public URL of the deployed app. Also the domain encoded in printed QR Codes.
NEXTAUTH_URL="https://your-domain.example.com"
# "true" only behind a reverse proxy other than Vercel.
AUTH_TRUST_HOST="false"

# --- Private photo storage (Supabase Storage) ---------------------------
# Create a PRIVATE bucket. The key is server-only; never expose it.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""   # legacy projects
SUPABASE_BUCKET="equipment-photos"

# --- Seed (npm run seed) -------------------------------------------------
ADMIN_EMAIL="admin@your-company.com"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD=""
