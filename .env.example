# --- Database (PostgreSQL) ---------------------------------------------
# Neon: pooled connection string (host with "-pooler") used by the app.
DATABASE_URL="postgresql://user:password@host-pooler.example.com/dbname?sslmode=require"
# Neon: direct (non-pooled) connection, used only by prisma migrate.
DIRECT_URL="postgresql://user:password@host.example.com/dbname?sslmode=require"

# --- Auth (Auth.js / NextAuth v5) ---------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
# Public URL of the deployed app. Also the domain encoded in printed QR Codes.
NEXTAUTH_URL="https://your-domain.example.com"
# "true" only behind a reverse proxy other than Vercel.
AUTH_TRUST_HOST="false"

# --- Private photo storage (Neon Object Storage, S3-compatible) --------
# Neon Console → Connect → Storage (or `neon credentials create --scope
# storage:read --scope storage:write`). Server-only; never expose to the browser.
AWS_ENDPOINT_URL_S3="https://br-xxxx.storage.c-1.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_..."
AWS_SECRET_ACCESS_KEY="nsk_live_..."
AWS_REGION="us-east-2"
# Private bucket on the same Neon branch.
STORAGE_BUCKET="equipment-photos"

# --- Seed (npm run seed) -------------------------------------------------
ADMIN_EMAIL="admin@your-company.com"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD=""
